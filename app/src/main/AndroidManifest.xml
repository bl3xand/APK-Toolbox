<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Requested up front so APK files anywhere in shared storage can be worked with. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- The same access on Android 10 and older, where it is an ordinary permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <!-- The whole point of the app is listing every installed package to pick one to clone. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION" />
    <uses-permission android:name="android.permission.ENFORCE_UPDATE_OWNERSHIP" />
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Only for the "confirm this update" notification a background check may need to show. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Sources tab fetches release information and APKs; the network state decides
         whether a background check runs and whether it may download. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".App"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        tools:replace="android:allowBackup"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.ApkCloner">

        <activity
            android:name=".ui.main.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- APK files and bundles shared or opened from another app can be installed or merged.
                 Bundles have no registered type of their own, hence the generic ones. -->
            <intent-filter android:label="@string/merge_open_with">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <intent-filter android:label="@string/merge_open_with">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/vnd.android.package-archive" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/vnd.apkm" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>
            <!-- A link shared from a browser or another app is offered for tracking. -->
            <intent-filter android:label="@string/sources_share_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- App configuration links in the reference app's format. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="obtainium" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".install.InstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".install.UninstallReceiver"
            android:exported="false" />

        <receiver
            android:name=".sources.work.CancelDownloadReceiver"
            android:exported="false" />

        <!-- Hands a downloaded APK to a verifier app before its first install. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.sources"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/sources_file_paths" />
        </provider>

        <!-- Lets Shizuku deliver its binder to this app; used for the optional Shizuku install method. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>
